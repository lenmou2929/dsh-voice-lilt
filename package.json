{
  "name": "dsh-voice-lilt",
  "version": "1.0.0",
  "type": "module",
  "description": "让模型挑出要念的话，用本机或云端语音引擎念出来并在 DSH 窗口内播放；支持角色扮演、多角色分嗓音与情感陪伴",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.mjs",
    "client.js",
    "lib/tts.mjs",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "spike/probe.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
